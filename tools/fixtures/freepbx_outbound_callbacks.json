    "func-apply-sipheaders": [
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "1",
        "Application": "ExecIf",
        "AppData": "$[\"${CRM_DIRECTION}\"=\"INBOUND\"]?Set(CHANNEL(hangup_handler_push)=crm-hangup,s,1)"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "2",
        "Application": "Noop",
        "AppData": "Applying SIP Headers to channel ${CHANNEL}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "3",
        "Application": "Set",
        "AppData": "localchan=${CUT(CHANNEL,/,2)}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "4",
        "Application": "Set",
        "AppData": "DialMCEXT=${CUT(localchan,-,1)}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "5",
        "Application": "Set",
        "AppData": "CHANNEL(hangup_handler_push)=app-missedcall-hangup,${DialMCEXT},1"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "6",
        "Application": "Set",
        "AppData": "Dchan=${CUT(CHANNEL,/,2)}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "7",
        "Application": "Set",
        "AppData": "DIALLEGEXT=${IF($[${LEN(${DialMCEXT})}>0]?${DialMCEXT}:${CUT(${Dchan},-,1)})}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "8",
        "Application": "Set",
        "AppData": "RG_VOLHDRKEY=Alert-Info-Ring-Volume"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "9",
        "Application": "Set",
        "AppData": "RG_PERLEG=${RG_SHARED_RVOL}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "10",
        "Application": "GotoIf",
        "AppData": "$[\"${RG_PERLEG}\" = \"0\"]?headers"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "11",
        "Application": "Gosub",
        "AppData": "sub-check-pseries,s,1(${DIALLEGEXT})"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "12",
        "Application": "Set",
        "AppData": "TECH=${CUT(CHANNEL,/,1)}",
        "ExtensionLabel": "headers"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "13",
        "Application": "Set",
        "AppData": "SIPHEADERKEYS=${IF($[${LEN(${HASHKEYS(__SIPHEADERS)})}>0]?${HASHKEYS(__SIPHEADERS)}:${HASHKEYS(SIPHEADERS)})}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "14",
        "Application": "While",
        "AppData": "$[\"${SET(sipkey=${SHIFT(SIPHEADERKEYS)})}\" != \"\"]"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "15",
        "Application": "Set",
        "AppData": "sipheader=${IF($[${LEN(${HASH(__SIPHEADERS,${sipkey})})}>0]?${HASH(__SIPHEADERS,${sipkey})}:${HASH(SIPHEADERS,${sipkey})})}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "16",
        "Application": "GotoIf",
        "AppData": "$[\"${RG_PERLEG}\" = \"0\"]?applyheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "17",
        "Application": "GotoIf",
        "AppData": "$[\"${sipkey}\" = \"${RG_VOLHDRKEY}\" & \"${IS_PPHONE}\" != \"1\"]?nextheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "18",
        "Application": "GotoIf",
        "AppData": "$[\"${sipkey}\" != \"Alert-Info\" | \"${IS_PPHONE}\" = \"1\"]?applyheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "19",
        "Application": "GotoIf",
        "AppData": "$[${REGEX(\"volume=\" ${sipheader})} = 1]?applyheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "20",
        "Application": "Set",
        "AppData": "RVOL_USE=${IF($[\"${RVOL}\"!=\"\"]?${RVOL}:${RVOLPARENT})}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "21",
        "Application": "GotoIf",
        "AppData": "$[\"${RVOL_USE}\" = \"\"]?applyheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "22",
        "Application": "Set",
        "AppData": "RG_AITONE=${IF($[\"${ALERT_INFO}\"!=\"\"]?${ALERT_INFO}:Normal)}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "23",
        "Application": "Set",
        "AppData": "sipheader=${RG_AITONE};volume=${RVOL_USE}"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "24",
        "Application": "Noop",
        "AppData": "",
        "ExtensionLabel": "applyheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "25",
        "Application": "ExecIf",
        "AppData": "$[\"${sipheader}\" = \"unset\" & \"${TECH}\" = \"PJSIP\"]?Set(PJSIP_HEADER(remove,${sipkey})=)"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "26",
        "Application": "ExecIf",
        "AppData": "$[\"${sipheader}\" != \"unset\" & \"${sipkey}\" = \"Alert-Info\" & ${REGEX(\"^<[^>]*>\" ${sipheader})} != 1 & ${REGEX(\";info=\" ${sipheader})} != 1]?Set(sipheader=<http://127.0.0.1>;info=${sipheader})"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "27",
        "Application": "ExecIf",
        "AppData": "$[\"${sipheader}\" != \"unset\" & \"${sipkey}\" = \"Alert-Info\" & ${REGEX(\"^<[^>]*>\" ${sipheader})} != 1]?Set(sipheader=<http://127.0.0.1>${sipheader})"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "28",
        "Application": "ExecIf",
        "AppData": "$[\"${TECH}\" = \"PJSIP\" & \"${sipheader}\" != \"unset\"]?Set(PJSIP_HEADER(add,${sipkey})=${sipheader})"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "29",
        "Application": "EndWhile",
        "AppData": "",
        "ExtensionLabel": "nextheader"
      },
      {
        "Context": "func-apply-sipheaders",
        "Extension": "s",
        "Priority": "30",
        "Application": "Return",
        "AppData": ""
      },
      {
        "Context": "func-apply-sipheaders",
        "IncludeContext": "func-apply-sipheaders-custom"
      }
    ]
  },
