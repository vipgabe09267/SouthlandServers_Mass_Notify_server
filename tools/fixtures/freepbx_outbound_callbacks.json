    "app-missedcall-hangup": [
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "1",
        "Application": "Noop",
        "AppData": "Dialed: ${EXTEN}"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "2",
        "Application": "Noop",
        "AppData": "Caller: ${MCEXTEN}"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "3",
        "Application": "GotoIf",
        "AppData": "$[\"${CHANNEL(LINKEDID)}\"!=\"${CHANNEL(UNIQUEID)}\" & \"${EXTEN}\"=\"s\"]?exit"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "4",
        "Application": "Set",
        "AppData": "EXTENNUM=${CUT(EXTEN,@,1)}"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "5",
        "Application": "Set",
        "AppData": "FEXTENNUM=${IF($[[\"${EXTENNUM:0:2}\"=\"90\"] || [\"${EXTENNUM:0:2}\"=\"98\"]]?${EXTENNUM:2}:${EXTEN})}"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "6",
        "Application": "GotoIf",
        "AppData": "$[${DB_EXISTS(AMPUSER/${FEXTENNUM}/missedcall)} & \"${DB(AMPUSER/${FEXTENNUM}/missedcall)}\"=\"disable\"]?exit"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "7",
        "Application": "AGI",
        "AppData": "agi://127.0.0.1/missedcallnotify.php,${FEXTENNUM},,${FEXTENNUM},${DB_EXISTS(AMPUSER/${FEXTENNUM}/missedcall)},${DB(AMPUSER/${FEXTENNUM}/missedcall)},${CHANNEL},${DIALSTATUS},${MCQUEUE},${MCGROUP},${FMFM}"
      },
      {
        "Context": "app-missedcall-hangup",
        "Extension": "_.",
        "Priority": "8",
        "Application": "Return",
        "AppData": "",
        "ExtensionLabel": "exit"
      },
      {
        "Context": "app-missedcall-hangup",
        "IncludeContext": "app-missedcall-hangup-custom"
      }
    ],
