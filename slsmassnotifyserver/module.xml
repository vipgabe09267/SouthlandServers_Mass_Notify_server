<module>
	<rawname>slsmassnotifyserver</rawname>
	<repo>custom</repo>
	<name>Southland Servers Mass Notifications Server</name>
	<version>0.1.1-beta</version>
	<publisher>Southland Servers</publisher>
	<license>AGPLv3+</license>
	<licenselink>http://www.gnu.org/licenses/agpl-3.0.txt</licenselink>
	<candisable>yes</candisable>
	<canuninstall>yes</canuninstall>
	<category>User Panel Z</category>
	<description>
		Southland Servers Mass Notifications Server for FreePBX. Provides SIP NOTIFY alerts, scheduled announcements, U.S. weather.gov and optional Xweather notifications, live desktop notifications, and Piper TTS audio.
	</description>
	<menuitems>
		<slsmassnotifyserver_help category="Mass Notify" sort="1">Help</slsmassnotifyserver_help>
		<slsmassnotifyserver category="Mass Notify" sort="2">Notification Logs</slsmassnotifyserver>
		<slsmassnotifyserver_other category="Mass Notify" sort="3">General Settings</slsmassnotifyserver_other>
		<slsmassnotifyserver_scheduling category="Mass Notify" sort="4">Scheduling</slsmassnotifyserver_scheduling>
		<slsmassnotifyserver_nws category="Mass Notify" sort="5">Weather Alerts</slsmassnotifyserver_nws>
		<slsmassnotifyserver_lightning category="Mass Notify" sort="6">Lightning Alerts</slsmassnotifyserver_lightning>
	</menuitems>
	<supported>
		<version>17.0</version>
	</supported>
	<depends>
		<version>17.0</version>
		<module>framework ge 17.0.0</module>
		<module>dashboard ge 17.0.0</module>
		<module>backup ge 17.0.0</module>
		<module>recordings ge 17.0.0</module>
	</depends>
	<hooks>
		<dashboard class="Overview" namespace="FreePBX\modules\Dashboard\Sections">
			<method callingMethod="getSummary" class="Slsmassnotifyserver" namespace="FreePBX\modules">dashboardService</method>
		</dashboard>
		<Backup class="Backup" namespace="FreePBX\modules">
			<method callingMethod="postrestoreModulehook" class="Slsmassnotifyserver" namespace="FreePBX\modules">postRestoreHook</method>
		</Backup>
	</hooks>
	<location/>
	<md5sum/>
</module>
