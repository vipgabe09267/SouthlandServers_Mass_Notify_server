#!/usr/bin/python3 -I
"""SLS runtime console entrypoint; installed by the authenticated installer."""
import os
from pathlib import Path
import stat
import sys

sys.dont_write_bytecode = True
helper = Path('/usr/local/bin/sls_mass_notify/sls_console.py')
try:
    for item in [Path(__file__).absolute(), helper, *helper.parents]:
        info = item.lstat()
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('SLS console executable or directory is not protected.')
    for item in (Path(__file__).absolute(), helper):
        info = item.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise RuntimeError('SLS console executable is not a protected regular file.')
    os.execve('/usr/bin/python3', ['/usr/bin/python3', '-I', str(helper), *sys.argv[1:]],
              {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'})
except (OSError, RuntimeError) as error:
    print('SLS console: ' + str(error), file=sys.stderr)
    raise SystemExit(1)
